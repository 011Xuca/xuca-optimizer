::EDGEBAT::reg delete "HKU\%1\SOFTWARE\WOW6432Node\Microsoft\Edge" /f
::EDGEBAT::reg delete "HKU\%1\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate" /f
::EDGEBAT::reg delete "HKU\%1\SOFTWARE\WOW6432Node\Microsoft\MicrosoftEdge" /f
::EDGEBAT::
