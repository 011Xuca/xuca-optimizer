set "QID=rc"
set "Q=- Desea desactivar Recall? (Capturas de pantalla con IA; solo en PCs Copilot+)"
call :askR
if errorlevel 3 goto rc_r
if errorlevel 2 goto rc_fin
call :opt_ini "Recall"
echo   Revisando si Recall existe en esta PC, un momento...
set "ACT=RECALL_OFF"
call :aplicar_ps
if errorlevel 5 goto rc_regs
if errorlevel 2 goto rc_noex
call :resps
:rc_regs
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsAI" "DisableAIDataAnalysis" REG_DWORD 1
call :reg "HKCU\SOFTWARE\Policies\Microsoft\Windows\WindowsAI" "DisableAIDataAnalysis" REG_DWORD 1
