::EDGEBAT::REM check script and %tmp% directories for file, check file hash, (re-)download from URL if required
::EDGEBAT::REM if file successfully validated its full path will be stored to variable
::EDGEBAT::REM arguments: file name, file hash, file URL and variable name in this exact order
::EDGEBAT::REM return result as exit code
::EDGEBAT:::file_obtain
::EDGEBAT::echo [file_obtain()] %cll_dbg%
::EDGEBAT::echo   name: "%~1" %cll_dbg%
::EDGEBAT::echo   hash: "%~2" %cll_dbg%
::EDGEBAT::echo   url:  "%~3" %cll_dbg%
::EDGEBAT::echo   var:  "%~4" %cll_dbg%
::EDGEBAT::if "%~1" equ "" goto _file_obtain.fail
::EDGEBAT::if "%~2" equ "" goto _file_obtain.fail
::EDGEBAT::if "%~3" equ "" goto _file_obtain.fail
::EDGEBAT::if "%~4" equ "" goto _file_obtain.fail
::EDGEBAT::
::EDGEBAT::set "on_hash_err=download"
::EDGEBAT::set "file_path=%~dp0%~1"
::EDGEBAT::if exist "%file_path%" goto _file_obtain.check
::EDGEBAT::set "file_path=%tmp%\%~1"
::EDGEBAT::if exist "%file_path%" goto _file_obtain.check
::EDGEBAT::
::EDGEBAT::echo file not cached %cll_dbg%
::EDGEBAT::
::EDGEBAT:::_file_obtain.download
::EDGEBAT::if %has_net% equ 0 goto _file_obtain.net.fail
::EDGEBAT::
::EDGEBAT::echo [file_obtain().download] %cll_dbg%
::EDGEBAT::set "on_hash_err=check.fail"
::EDGEBAT::powershell -noprofile -c "[Net.WebClient]::new().DownloadFile('%~3', '%file_path%')"
::EDGEBAT::if %errorlevel% neq 0 goto _file_obtain.download.fail
::EDGEBAT::if not exist "%file_path%" goto _file_obtain.download.fail
::EDGEBAT::
::EDGEBAT:::_file_obtain.check
::EDGEBAT::echo [file_obtain().check] "%file_path%"; on_hash_err: "%on_hash_err%" %cll_dbg%
::EDGEBAT::powershell -noprofile -c "Import-Module Microsoft.PowerShell.Utility; exit ((Get-FileHash '%file_path%' -Algorithm SHA256).Hash.ToLower() -ne '%~2')"
::EDGEBAT::if %errorlevel% neq 0 goto _file_obtain.%on_hash_err%
::EDGEBAT::
::EDGEBAT::set "%~4=%file_path%"
::EDGEBAT::echo [file_obtain().done] %cll_dbg%
::EDGEBAT::exit /b 0
::EDGEBAT::
::EDGEBAT:::_file_obtain.fail
::EDGEBAT::set "errorinfo=%ISSUE_GENERIC%: generic"
::EDGEBAT::echo [file_obtain().fail] %cll_dbg%
::EDGEBAT::exit /b %ISSUE_GENERIC%
::EDGEBAT::
::EDGEBAT:::_file_obtain.net.fail
::EDGEBAT::set "errorinfo=%ISSUE_NETWORK%: no network"
::EDGEBAT::echo [file_obtain().net.fail] %cll_dbg%
::EDGEBAT::exit /b %ISSUE_NETWORK%
::EDGEBAT::
::EDGEBAT:::_file_obtain.download.fail
::EDGEBAT::set "errorinfo=%ISSUE_DOWNLOAD%: download error"
::EDGEBAT::echo [file_obtain().download.fail] %cll_dbg%
::EDGEBAT::exit /b %ISSUE_DOWNLOAD%
::EDGEBAT::
::EDGEBAT:::_file_obtain.check.fail
::EDGEBAT::set "errorinfo=%ISSUE_HASH%: hash mismatch"
::EDGEBAT::echo [file_obtain().check.fail] %cll_dbg%
::EDGEBAT::exit /b %ISSUE_HASH%
