set "QID=drv"
set "Q=- Desea buscar los drivers recomendados para tu PC? (Solo los necesarios; se abre la pagina oficial de cada uno)"
call :askS
if errorlevel 2 goto drv_fin
call :opt_ini "Drivers recomendados"
set "ACT=DRIVERS"
call :aplicar_ps
call :resps
call :opt_fin "Revision de drivers terminada"
:drv_fin


echo.
echo.
echo %C_TIT%=== CUENTA ===%C_RST%
echo %C_WARN%AVISO: despues de borrar una cuenta, reinicia la PC para que Configuracion deje de mostrarla.%C_RST%
echo.
echo   Que hace: te deja elegir otra cuenta de la PC y borrarla.
echo   A favor: limpia cuentas viejas que ya no usas.
echo   En contra: si tambien borras su carpeta, se pierden sus archivos.
set "QID=ms_acc"
set "Q=- Desea borrar una cuenta de esta PC? (Elegis cual: usuario de Windows o cuenta de Microsoft vinculada; tu cuenta actual no se toca)"
call :askS
if errorlevel 2 goto ms_acc_fin
call :opt_ini "Borrar cuentas"
set "ACT=MS_ACC_REMOVE"
call :aplicar_ps
call :resps
call :opt_fin "Borrado de cuentas finalizado"
:ms_acc_fin

echo.
echo %C_WARN%AVISO: sin contrasena entra cualquiera que prenda la PC, y no anda el Escritorio remoto.%C_RST%
echo %C_WARN%AVISO: si tu cuenta es de Microsoft, Windows cierra la sesion al terminar y el script se abre solo al volver a entrar.%C_RST%
echo.
echo   Que hace: tu cuenta pasa a ser local y sin contrasena.
echo   A favor: entras directo a Windows.
echo   En contra: cualquiera que prenda la PC entra, y no anda el Escritorio remoto.
set "QID=al"
set "Q=- Desea entrar a Windows sin contrasena? (Tu cuenta pasa a local sin contrasena: tocas Iniciar sesion y entras)"
call :askR
if errorlevel 3 goto al_r
if errorlevel 2 goto al_fin
call :opt_ini "Entrar sin contrasena"
set "ACT=LOCALPW_OFF"
call :aplicar_ps
call :resps
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "AutoAdminLogon" REG_SZ 0
call :regdel "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "DefaultPassword"
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device" "DevicePasswordLessBuildVersion" REG_DWORD 0
call :opt_fin "Cuenta sin contrasena: al prender la PC tocas Iniciar sesion y entras"
goto al_fin
:al_r
call :opt_ini "Entrar sin contrasena (restaurar)"
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "AutoAdminLogon" REG_SZ 0
call :regdel "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "DefaultPassword"
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device" "DevicePasswordLessBuildVersion" REG_DWORD 2
start "" ms-settings:signinoptions
call :opt_fin "Restos del inicio automatico borrados. Para poner contrasena nueva usa la pagina que se abrio"
:al_fin
if defined XUCA_AUTO goto act_fin
echo.
<nul set /p "=%C_VIO%- Desea activar Windows? (Se abre en otro PowerShell) [S] Si  [N] No: %C_RST%"
choice /c SN /n
if errorlevel 2 (
    call :log "PREG" "N - Desea activar Windows?"
) else (
    call :log "PREG" "S - Desea activar Windows?"
    start "" powershell -NoProfile -ExecutionPolicy Bypass -NoExit -Command "irm https://get.activated.win | iex"
)
:act_fin

call :resumen

if not defined VGAVISO goto sin_aviso_vg
echo.
echo %C_WARN%OBLIGATORIO REINICIAR ANTES DE PODER JUGAR VALORANT YA QUE DESACTIVASTE LOS AJUSTES DE SEGURIDAD.%C_RST%
call :log "ATENCION" "Se desactivaron ajustes de seguridad: hay que reiniciar antes de jugar Valorant"
:sin_aviso_vg

set "Q=Desea abrir el log ahora?"
call :askS
if not errorlevel 2 start "" notepad "%LOG%"


if defined VGAVISO set "REINICIO=1"
if defined REINICIO goto fin_pide_reinicio
echo.
echo %C_OK%No hace falta reiniciar: los cambios ya quedaron aplicados.%C_RST%
if not defined XUCA_AUTO pause
exit /b
:fin_pide_reinicio
echo.
echo %C_WARN%Hace falta reiniciar la PC para terminar de aplicar algunos cambios.%C_RST%
set "Q=Desea reiniciar ahora?"
call :askS
if errorlevel 2 goto fin_sin_reinicio
echo Reiniciando en 10 segundos...
shutdown /r /t 10
goto fin_script
:fin_sin_reinicio
echo Reinicia cuando puedas.
if not defined XUCA_AUTO pause
exit /b
:fin_script
exit /b


:modo_cuenta
cls
echo.
echo %C_TIT%=== CONFIRMAR CAMBIO DE CUENTA ===%C_RST%
echo   Windows cerro la sesion para pasar tu cuenta a local. Falta quitar la contrasena.
set "QID=cta"
set "Q=- Desea terminar de quitar la contrasena ahora? (Se confirma el cambio y el script se cierra)"
call :askS
