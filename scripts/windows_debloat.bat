@echo off
setlocal EnableExtensions
set "XUCA_SELF=%~f0"
rem ============================================================
rem  ACTUALIZACIONES DESDE GITHUB
rem  La version se controla con el archivo version.txt del repo.
rem  Si el version.txt de GitHub es distinto al que tenes en tu PC,
rem  al abrir sale el cartel amarillo de actualizacion.
rem ============================================================
set "XUCA_REPO=011Xuca/xuca-optimizer"
set "XUCA_RAMA=main"
set "XUCA_GH=scripts/windows_debloat.bat"
rem Si el archivo quedo con saltos de linea de Linux (LF), cmd salta a etiquetas equivocadas: se corrige solo y se vuelve a abrir.
powershell -NoProfile -ExecutionPolicy Bypass -Command "try { $f=$env:XUCA_SELF; $e=[Text.Encoding]::GetEncoding(28591); $t=$e.GetString([IO.File]::ReadAllBytes($f)); if ($t -match '(^|[^\r])\n') { [IO.File]::WriteAllText($f, ($t -replace '\r?\n', ([string][char]13 + [char]10)), $e); exit 9 }; exit 0 } catch { exit 0 }" >nul 2>&1
if errorlevel 9 "%~f0" %*
title Windows Debloat (Xuca)

:: ============================================================
::  WINDOWS Debloat
::  Compatible con Windows 11 v. 25H2
::  S = Si, N = No, R = Restaurar. R deja la opcion en el valor
::  por defecto de Windows, no en lo que tenias antes.
::  Cada cambio se verifica y queda anotado en la carpeta "logs".
:: ============================================================

set "ARCHIVO=%~f0"
set "ACT="
set "SPI="
set "LOG="
set "BUILD=0"
set "RAMGB=0"
set "ESHDD=0"
set "STAMP=sin-fecha"
set "OPT_T=0"
set "OPT_F=0"
set "OPT_S=0"
set "OPT_P=0"
set "CHK="
set "VGAVISO="
set "VG_HECHO="
set "VGT="
set "QACT="
set "REINICIO="
rem Opciones que necesitan reiniciar para aplicarse. Solo se pide reiniciar si alguna de estas cambio algo de verdad.
set "REIN_IDS= av rc ad sv pv ms_acc al cta "

net session >nul 2>&1
if %errorlevel% neq 0 (
    echo Pidiendo permisos de administrador...
    if "%~1"=="" (powershell -NoProfile -Command "Start-Process -FilePath $env:XUCA_SELF -Verb RunAs") else (powershell -NoProfile -Command "Start-Process -FilePath $env:XUCA_SELF -ArgumentList '%~1' -Verb RunAs")
    exit /b
)

rem Buscar actualizacion en GitHub (no corre cuando lo usa la app ni cuando se abre con parametros).
rem Si hay una version nueva muestra el cartel amarillo y pregunta. Si la bajas, se cierra esta ventana y se abre la nueva.
if defined XUCA_AUTO goto upd_fin
if not "%~1"=="" goto upd_fin
powershell -NoProfile -ExecutionPolicy Bypass -Command "$global:XucaUpd=0; try { $s=[IO.File]::ReadAllText($env:XUCA_SELF); $a='<#'+'XUCA-UPD'; $b='XUCA-UPD'+'#>'; $i=$s.IndexOf($a)+$a.Length; Invoke-Expression $s.Substring($i, $s.IndexOf($b)-$i) } catch { }; exit [int]$global:XucaUpd"
if errorlevel 10 exit
:upd_fin

del /q "%TEMP%\xuca_info.txt" >nul 2>&1
set "ACT=INFO"
call :aplicar_ps
set "INFO="
if exist "%TEMP%\xuca_info.txt" set /p INFO=<"%TEMP%\xuca_info.txt"
set "PSMAL=0"
if not defined INFO set "PSMAL=1"
if defined INFO for /f "tokens=1-4" %%A in ("%INFO%") do (set "BUILD=%%A" & set "RAMGB=%%B" & set "ESHDD=%%C" & set "STAMP=%%D")
if %BUILD% EQU 0 for /f "tokens=3" %%V in ('reg query "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion" /v CurrentBuildNumber 2^>nul ^| findstr /i "CurrentBuildNumber"') do set "BUILD=%%V"
if "%STAMP%"=="sin-fecha" set "STAMP=%date:/=-%_%time:~0,8%"
set "STAMP=%STAMP::=-%"
set "STAMP=%STAMP: =0%"

set "ESC="
set "C_OK="
set "C_ERR="
set "C_WARN="
set "C_TIT="
set "C_RST="
set "C_BTN="
if %BUILD% GEQ 17763 for /f %%a in ('echo prompt $E ^| cmd') do set "ESC=%%a"
if defined ESC set "C_OK=%ESC%[92m"
if defined ESC set "C_ERR=%ESC%[91m"
if defined ESC set "C_WARN=%ESC%[93m"
if defined ESC set "C_TIT=%ESC%[96m"
if defined ESC set "C_RST=%ESC%[0m"
if defined ESC set "C_BTN=%ESC%[30;105m"
set "C_VIO="
if defined ESC set "C_VIO=%ESC%[95m"

set "LOGDIR=%~dp0logs"
if not exist "%LOGDIR%\" mkdir "%LOGDIR%" >nul 2>&1
if not exist "%LOGDIR%\" set "LOGDIR=%TEMP%"
set "LOG=%LOGDIR%\windows_debloat_%STAMP%.txt"
set "ACT=HEADER"
call :aplicar_ps
call :log "INFO" "Inicio de windows_debloat.bat"
if "%PSMAL%"=="1" call :log "ATENCION" "PowerShell no devolvio datos: puede estar bloqueado por el antivirus. Mira las lineas PS-ERROR"
if /i "%~1"=="/cuenta" goto modo_cuenta

del /q "%TEMP%\xuca_orig.txt" >nul 2>&1
set "ACT=ORIG_CHECK"
call :aplicar_ps
set "ORIGMSG="
if exist "%TEMP%\xuca_orig.txt" set /p ORIGMSG=<"%TEMP%\xuca_orig.txt"
if defined ORIGMSG set "ORIGMSG=%ORIGMSG:&= %"
if defined ORIGMSG set "ORIGMSG=%ORIGMSG:|= %"
if defined ORIGMSG set "ORIGMSG=%ORIGMSG:<= %"
if defined ORIGMSG set "ORIGMSG=%ORIGMSG:>= %"

cls
echo WINDOWS DEBLOAT - build detectado: %BUILD%
if %BUILD% LSS 22000 echo Nota: esto esta pensado para Windows 11, en Windows 10 algunas opciones pueden no existir o fallar.
if %BUILD% GTR 0 if %BUILD% LSS 26300 (
    echo.
    echo %C_TIT%=== RECOMENDACION: ACTUALIZA A WINDOWS 11 26H2 ===%C_RST%
    echo   Tu build actual es %BUILD% y la 26H2 es la build 26300.
    echo   Si tenes 24H2 o 25H2 es una actualizacion chica por Windows Update, con un reinicio corto.
    echo   Abri Configuracion, Windows Update, y busca actualizaciones.
)
if defined ORIGMSG (
    echo.
    echo %C_WARN%AVISO: esta PC no parece tener una version original o estandar de Windows.%C_RST%
    echo %C_WARN%Motivo: %ORIGMSG%%C_RST%
    echo %C_WARN%En versiones recortadas, pirateadas o modificadas ^(Tiny11, AtlasOS, ReviOS y similares^) varias opciones de este script pueden fallar o no aplicar.%C_RST%
    call :log "ATENCION" "Posible Windows no original o version rara - %ORIGMSG%"
)
if "%PSMAL%"=="1" (
    echo.
    echo %C_ERR%AVISO: PowerShell no pudo ejecutar la parte avanzada del script en esta PC.%C_RST%
    echo %C_ERR%Puede ser el antivirus bloqueandolo. Muchas opciones van a fallar: mira el log.%C_RST%
)
echo.
echo Responde con S [Si], N [No] y, donde aparezca, R [Restaurar al valor por defecto de Windows].
echo Cada cambio se verifica y queda anotado en: %LOG%
echo.
if not defined XUCA_AUTO pause

if %BUILD% EQU 0 goto ver_fin
if %BUILD% GEQ 26300 goto ver_ya
echo.
echo.
echo %C_TIT%=== VERSION DE WINDOWS ===%C_RST%
if %BUILD% GEQ 26100 goto ver_24h2
echo.
echo   Tenes una version de Windows mas vieja que la 24H2 [build %BUILD%].
echo   Se puede forzar la actualizacion a Windows 11 25H2 aunque tu PC no sea compatible.
echo   - Actualiza todo Windows y conserva tus archivos y programas.
echo   - Tarda cerca de una hora y reinicia varias veces. Hace backup antes.
echo   - No es un camino oficial de Microsoft: puede fallar en PCs no compatibles.
echo   - Piso que no se puede saltear: CPU de 64 bits con SSE4.2, 4 GB de RAM y 64 GB de disco.
echo   - Necesitas el ISO oficial de Windows 11 25H2 de microsoft.com.
echo   - Despues, la 26H2 te llega por Windows Update con un reinicio corto.
echo.
echo   Que hace: instala Windows 11 25H2 desde el ISO oficial aunque tu PC no cumpla los requisitos.
echo   A favor: tenes la version nueva con sus mejoras y parches de seguridad.
echo   En contra: tarda cerca de una hora, no es un camino oficial y en PCs no compatibles puede fallar.
set "QID=ver"
set "Q=- Desea forzar la actualizacion a Windows 11 25H2? (Pide el ISO oficial e ignora los requisitos de hardware)"
call :askS
if errorlevel 2 goto ver_fin
call :opt_ini "Actualizar a Windows 11 25H2"
set "ACT=WIN_UPGRADE"
call :aplicar_ps
if errorlevel 4 goto ver_cancel
if errorlevel 3 goto upg_lanzado
call :resps
call :opt_fin "Actualizacion preparada"
goto ver_fin

:ver_24h2
echo.
echo   Tenes Windows 11 24H2 o 25H2 [build %BUILD%]. La 26H2 es una actualizacion chica que no revisa el hardware de nuevo.
echo.
echo   Que hace: le pide a Windows Update la version 26H2.
echo   A favor: es una actualizacion chica, con un solo reinicio corto, y usa menos RAM.
echo   En contra: ninguno importante; como toda actualizacion, conviene tener backup.
set "QID=ver"
set "Q=- Desea actualizar a Windows 11 26H2? (Por Windows Update, con reinicio corto)"
call :askS
if errorlevel 2 goto ver_fin
call :opt_ini "Actualizar a Windows 11 26H2"
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "TargetReleaseVersion" REG_DWORD 1
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "ProductVersion" REG_SZ "Windows 11"
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsUpdate" "TargetReleaseVersionInfo" REG_SZ 26H2
UsoClient StartScan >nul 2>&1
call :log "INFO" "UsoClient StartScan lanzado"
start "" ms-settings:windowsupdate
echo   Se abrio Windows Update: instala lo que aparezca y reinicia.
echo   Si todavia no te ofrece la 26H2, volve a buscar en unos dias: Microsoft la va liberando de a poco.
call :opt_fin "Windows 11 26H2 pedida a Windows Update"
goto ver_fin

:ver_ya
call :log "INFO" "la version de Windows ya es 26H2 o mas nueva - build %BUILD%"
goto ver_fin

:ver_cancel
call :log "INFO" "actualizacion cancelada"
echo %C_WARN%  Actualizacion cancelada, no se cambio nada.%C_RST%
goto ver_fin

:upg_lanzado
call :log "LISTO" "instalador de Windows 11 lanzado"
echo.
echo   El instalador de Windows 11 quedo abierto. No apagues la PC.
echo   Cuando termine y vuelvas al escritorio, corre este script de nuevo para aplicar las optimizaciones.
echo.
if not defined XUCA_AUTO pause
exit /b

:ver_fin

echo.
echo.
echo %C_TIT%=== PUNTOS DE RESTAURACION ===%C_RST%
echo   Que hace: apaga para siempre los puntos de restauracion y borra los que ya tenes.
echo   A favor: libera espacio en el disco y Windows deja de escribir copias en segundo plano.
echo   En contra: si algo sale mal ya no vas a poder volver atras con un punto de restauracion.
