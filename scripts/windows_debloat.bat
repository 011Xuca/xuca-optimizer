set "QID=rpo"
set "Q=- Desea apagar los puntos de restauracion para siempre? (Libera espacio; R los vuelve a encender)"
call :askR
if errorlevel 3 goto rpo_r
if errorlevel 2 goto rpo_fin
call :opt_ini "Puntos de restauracion apagados"
set "ACT=RP_OFF"
call :aplicar_ps
call :resps
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\SystemRestore" "DisableSR" REG_DWORD 1
call :reg "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\SystemRestore" "DisableConfig" REG_DWORD 1
call :opt_fin "Puntos de restauracion apagados para siempre"
goto rp_fin
:rpo_r
call :opt_ini "Puntos de restauracion apagados (restaurar)"
call :regdel "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\SystemRestore" "DisableSR"
call :regdel "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\SystemRestore" "DisableConfig"
set "ACT=RP_ON"
call :aplicar_ps
call :resps
call :opt_fin "Puntos de restauracion encendidos de nuevo"
:rpo_fin

set "ACT=RP_CHECK"
call :aplicar_ps
if errorlevel 5 goto rp_fin
echo.
echo   Que hace: guarda una copia del estado de Windows antes de los cambios del script.
echo   A favor: si algo sale mal, volves atras en unos minutos.
echo   En contra: ocupa algo de espacio en el disco.
set "QID=rp"
set "Q=- Desea crear un punto de restauracion? (Para volver atras si algo sale mal)"
call :askS
if errorlevel 2 goto rp_fin
call :opt_ini "Punto de restauracion"
set "ACT=RP_CREATE"
call :aplicar_ps
call :resps
call :opt_fin "Punto de restauracion creado"
:rp_fin

echo.
echo.
echo %C_TIT%=== SEGURIDAD ===%C_RST%
echo %C_WARN%AVISO: si tenes Riot Vanguard, se borra solo si una opcion de seguridad cambia algo de verdad (si ya la tenias asi, no se toca); se desinstala del todo, se cierra Riot y lo volves a instalar abriendo el cliente de Riot.%C_RST%
echo.
echo %C_WARN%AVISO: Smart App Control no se puede volver a encender sin reinstalar Windows.%C_RST%
echo %C_WARN%AVISO: la Proteccion contra alteraciones la apagas vos; el script abre la pagina.%C_RST%
echo %C_WARN%AVISO: con R, volve a activar la Proteccion contra alteraciones en Seguridad de Windows.%C_RST%
set "AVSI="
echo.
echo   Que hace: apaga Defender, SmartScreen y Smart App Control.
echo   A favor: menos uso de CPU y disco, y ningun analisis en medio de una partida.
echo   En contra: la PC queda sin proteccion contra virus y Smart App Control no se vuelve a encender sin reinstalar Windows.
set "QID=av"
set "Q=- Desea apagar TODO el antivirus? (Defender, SmartScreen y Smart App Control; la PC queda sin proteccion)"
call :askR
if errorlevel 3 goto av_r
if errorlevel 2 goto av_fin
call :opt_ini "Antivirus de Windows"
echo   Revisando el estado del antivirus, un momento...
set "ACT=AV_OFF"
set "CHK=1"
call :aplicar_ps
if errorlevel 5 goto av_ya
echo.
echo   Apaga ahora la Proteccion contra alteraciones: se abre la pagina de Seguridad de Windows.
echo   Cuando la apagues, volve aca.
if not defined XUCA_AUTO start "" windowsdefender://threatsettings
if not defined XUCA_AUTO pause
call :av_regs_off
set "ACT=AV_OFF"
call :aplicar_ps
call :resps
call :opt_fin "Antivirus, SmartScreen y Smart App Control desactivados"
if %OPT_F% GTR 0 echo %C_ERR%  Si algo fallo, casi seguro la Proteccion contra alteraciones sigue encendida: apagala y repeti.%C_RST%
call :vanguard_check
set "AVSI=1"
goto av_fin

:av_ya
call :av_regs_off
set /a OPT_S+=1
call :opt_fin "Antivirus, SmartScreen y Smart App Control desactivados"
set "AVSI=1"
goto av_fin

:av_r
call :opt_ini "Antivirus de Windows (restaurar)"
call :av_regs_on
set "ACT=AV_ON"
call :aplicar_ps
call :resps
call :opt_fin "Antivirus y SmartScreen restaurados"
:av_fin

echo.
echo   Que hace: descifra el disco y evita que Windows lo vuelva a cifrar solo.
echo   A favor: un poco mas de velocidad de disco y no te bloquea el acceso si cambias hardware o la BIOS.
echo   En contra: si te roban la PC, pueden leer tus archivos.
set "QID=bl"
set "Q=- Desea desactivar BitLocker? (Descifra el disco; con R solo se quita el bloqueo)"
call :askR
if errorlevel 3 goto bl_r
if errorlevel 2 goto bl_fin
call :opt_ini "BitLocker"
set "ACT=BL_OFF"
call :aplicar_ps
call :resps
rem Para Vanguard solo cuenta si el disco se empezo a descifrar ahora (no el bloqueo de abajo)
set "VGT=%OPT_T%"
call :reg "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" "PreventDeviceEncryption" REG_DWORD 1
call :opt_fin "BitLocker desactivado (el descifrado sigue en segundo plano)"
call :vanguard_check
goto bl_fin
:bl_r
call :opt_ini "BitLocker (restaurar)"
call :regdel "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" "PreventDeviceEncryption"
call :opt_fin "Se quito el bloqueo de BitLocker. Windows puede volver a cifrar el disco por su cuenta"
