            try { Add-Type -AssemblyName Microsoft.VisualBasic -ErrorAction Stop; $ram = [math]::Round((New-Object Microsoft.VisualBasic.Devices.ComputerInfo).TotalPhysicalMemory / 1GB) } catch { }
