call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ListviewAlphaSelect" REG_DWORD 0
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "IconsOnly" REG_DWORD 0
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ListviewShadow" REG_DWORD 0
call :reg "HKCU\Control Panel\Desktop\WindowMetrics" "MinAnimate" REG_SZ 0
call :reg "HKCU\Software\Microsoft\Windows\DWM" "AlwaysHibernateThumbnails" REG_DWORD 0
call :reg "HKCU\Software\Microsoft\Windows\DWM" "EnableAeroPeek" REG_DWORD 0
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" "VisualFXSetting" REG_DWORD 3
if %OPT_T% EQU 0 goto fx_s_ok
set "SPI=P:0x1043:0;P:0x1015:0;P:0x1017:0;P:0x1003:0;P:0x1007:0;A:0;P:0x1005:1;U:0x0025:1;P:0x101B:0;P:0x1025:1;U:0x004B:1;P:0x200B:2;"
set "ACT=SPI"
call :aplicar_ps
call :resps
:fx_s_ok
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" "EnableTransparency" REG_DWORD 0
call :opt_fin "Efectos visuales reducidos"
goto fx_fin
:fx_r
call :opt_ini "Efectos visuales (restaurar)"
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "TaskbarAnimations" REG_DWORD 1
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ListviewAlphaSelect" REG_DWORD 1
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "IconsOnly" REG_DWORD 0
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Advanced" "ListviewShadow" REG_DWORD 1
call :reg "HKCU\Control Panel\Desktop\WindowMetrics" "MinAnimate" REG_SZ 1
call :regdel "HKCU\Software\Microsoft\Windows\DWM" "AlwaysHibernateThumbnails"
call :reg "HKCU\Software\Microsoft\Windows\DWM" "EnableAeroPeek" REG_DWORD 1
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects" "VisualFXSetting" REG_DWORD 0
if %OPT_T% EQU 0 goto fx_r_ok
set "SPI=P:0x1043:1;P:0x1015:1;P:0x1017:1;P:0x1003:1;P:0x1007:1;A:1;P:0x1005:1;U:0x0025:1;P:0x101B:1;P:0x1025:1;U:0x004B:1;P:0x200B:2;"
set "ACT=SPI"
call :aplicar_ps
call :resps
:fx_r_ok
call :reg "HKCU\Software\Microsoft\Windows\CurrentVersion\Themes\Personalize" "EnableTransparency" REG_DWORD 1
call :opt_fin "Efectos visuales restaurados"
:fx_fin

rem Finalizar tarea en la barra existe desde Windows 11 22H2 (build 22621)
if %BUILD% GTR 0 if %BUILD% LSS 22621 (
    call :log "SALTADO" "Finalizar tarea: necesita Windows 11 22H2 o mas nuevo - build %BUILD%"
    goto et_fin
)
echo.
echo   Que hace: agrega Finalizar tarea al clic derecho de la barra de tareas.
echo   A favor: cerras un juego o programa trabado sin abrir el Administrador de tareas.
echo   En contra: ninguno.
