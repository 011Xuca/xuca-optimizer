call :reg "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\BootAnimation" "DisableStartupSound" REG_DWORD 1
set "ACT=SND_OFF"
call :aplicar_ps
call :resps
call :opt_fin "Sonidos de Windows silenciados (solo quedan conectar y desconectar dispositivos)"
goto sch_fin
:sch_r
call :opt_ini "Sonidos de Windows (restaurar)"
call :reg "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\LogonUI\BootAnimation" "DisableStartupSound" REG_DWORD 0
set "ACT=SND_ON"
call :aplicar_ps
call :resps
call :opt_fin "Sonidos de Windows restaurados (Predeterminado de Windows)"
