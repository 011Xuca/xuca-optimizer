::EDGEBAT::REM Get executor SID (Win 2003(XP x64) and up)
::EDGEBAT::for /f "skip=1 tokens=1,2 delims=," %%a in ('whoami /user /fo csv') do set "EXEC_SID=%%~b"
::EDGEBAT::REM When script elevates itself, the user SID should be passed as 1st argument (bad input here is not my fault)
::EDGEBAT::set "USER_SID=%~1"
::EDGEBAT::REM Check Admin permissions
::EDGEBAT::net session >NUL 2>&1
::EDGEBAT::echo err: %errorlevel%; EXEC_SID: "%EXEC_SID%"; USER_SID: "%USER_SID%" %bat_dbg%
::EDGEBAT::if %errorlevel% equ 0 goto uac.success
::EDGEBAT::REM When UAC disabled, elevation not works and SID never changes
::EDGEBAT::if /i "%EXEC_SID%" equ "%USER_SID%" (
::EDGEBAT::	echo Please, enable UAC and try again & echo. & pause & exit /b %ISSUE_UAC%
::EDGEBAT::)
::EDGEBAT::REM When 1st arg looks like valid NT_AUTHORITY SID, assume elevation by script (prevent infinite loop aka UAC bombing)
::EDGEBAT::if /i "%USER_SID:~0,6%" equ "S-1-5-" (
::EDGEBAT::	REM DO NOT put on the same line as condition: using another var after substring when its source is empty leads to hard fail
::EDGEBAT::	echo Built-in Admin account possibly corrupted & echo. & pause & exit /b %ISSUE_UAC%
::EDGEBAT::)
::EDGEBAT::REM Elevate with psl (don't try go around cmd /c; see Both.bat for quotes details)
::EDGEBAT::echo Start-Process -Verb RunAs """$env:COMSpec""" "%ecm% """"%~0"" ""%EXEC_SID%"""""|powershell -noprofile - %bat_log%
::EDGEBAT::echo [uac().elevated] err: "%errorlevel%" %bat_dbg%
::EDGEBAT::exit /b %errorlevel%
::EDGEBAT::
::EDGEBAT::REM Admin permissions granted, executor SID may be a SID of Built-in Admin account if it's enabled
::EDGEBAT:::uac.success
::EDGEBAT::echo [uac().success] %bat_dbg%
::EDGEBAT::REM 1st arg looks like valid rev.1 SID (assume elevation by script)
::EDGEBAT::if /i "%USER_SID:~0,4%" equ "S-1-" goto uac.done
::EDGEBAT::REM 1st arg does not look like valid SID (elevation NOT by script)
::EDGEBAT::set "USER_SID=%EXEC_SID%"
::EDGEBAT::REM When Built-in Admin account disabled, SID does not change on elevation and usually match the condition
::EDGEBAT::if "%EXEC_SID:~-4%" neq "-500" goto uac.done
::EDGEBAT::REM For automaters: when Built-in Admin account enabled, specify "-auto" as 1st argument to bypass confirmation
::EDGEBAT::if /i "%~1" equ "-auto" goto uac.done
::EDGEBAT::REM Built-in Admin account enabled and script not self elevated nor automated
::EDGEBAT::choice /c yn /n /m "Logged as Admin? [Y,N]"
::EDGEBAT::REM Check for positive answer, anything else considered as No
::EDGEBAT::echo answer: %errorlevel% %bat_dbg%
