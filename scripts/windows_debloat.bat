::EDGEBAT::if exist "%TEMP%\wv2_native_cs.reg" reg import "%TEMP%\wv2_native_cs.reg" %bat_log% & del /f /q "%TEMP%\wv2_native_cs.reg"
::EDGEBAT::
::EDGEBAT::echo [extra_cleanup().registry.inaccessible] %bat_dbg%
::EDGEBAT::call :reg_HKLM_keys_access_and_delete %bat_log%
::EDGEBAT::
::EDGEBAT::REM System32
::EDGEBAT::echo [extra_cleanup().files.System32] %bat_dbg%
::EDGEBAT::for %%f in ("%SystemRoot%\System32\MicrosoftEdge*.exe") do (
::EDGEBAT::	echo file: "%%~f" %bat_dbg%
::EDGEBAT::	takeown /f "%%~f" %bat_log%
::EDGEBAT::	icacls "%%~f" /grant "%UserName%:F" /c %bat_log%
::EDGEBAT::	del /f /q "%%~f" %bat_log%
::EDGEBAT::)
::EDGEBAT::
::EDGEBAT::
::EDGEBAT::REM Malformed Keys
::EDGEBAT::echo - Fixing registry
::EDGEBAT::echo [extra_cleanup().registry.fix] %bat_dbg%
::EDGEBAT::setlocal EnableDelayedExpansion
::EDGEBAT::set "reg_path=HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Appx\AppxAllUserStore"
::EDGEBAT::for /f "tokens=*" %%k in ('reg query "%reg_path%" /s 2^>NUL ^| findstr /b /i "%reg_path%"') do (
::EDGEBAT::	set "full_key=%%k"
::EDGEBAT::	set "delete_key=false"
::EDGEBAT::	set "reason="
::EDGEBAT::	for %%a in ("!full_key!") do set "key_name=%%~nxa"
::EDGEBAT::	REM Skip empty or unchanged names
::EDGEBAT::	if "!key_name!"=="" (
::EDGEBAT::		set "reason=empty key name"
::EDGEBAT::	) else if "!key_name!"=="!full_key!" (
::EDGEBAT::		set "reason=key name same as full path"
::EDGEBAT::	) else (
::EDGEBAT::		REM Check for space
::EDGEBAT::		set "spaced_key=!key_name: =!"
::EDGEBAT::		if not "!key_name!"=="!spaced_key!" (
::EDGEBAT::			set "delete_key=true"
::EDGEBAT::		) else (
::EDGEBAT::			REM Check for letters
::EDGEBAT::			echo /7 - !key_name! | findstr /r /c:"[a-zA-Z]" >NUL
::EDGEBAT::			if !errorlevel! neq 0 set "delete_key=true"
::EDGEBAT::		)
::EDGEBAT::	)
::EDGEBAT::	if "!delete_key!"=="true" reg delete "!full_key!" /f >nul 2>&1
::EDGEBAT::)
::EDGEBAT::endlocal
::EDGEBAT::
::EDGEBAT::
::EDGEBAT::echo [extra_cleanup().end] %bat_dbg%
::EDGEBAT::
::EDGEBAT::
::EDGEBAT::
::EDGEBAT::REM Main script end
::EDGEBAT::echo - Edge removal complete
::EDGEBAT::echo [main_script.end] %bat_dbg%
