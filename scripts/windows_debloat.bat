call :opt_ini "Entrar sin contrasena"
set "ACT=LOCALPW_FIN"
call :aplicar_ps
call :resps
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "AutoAdminLogon" REG_SZ 0
call :regdel "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" "DefaultPassword"
call :reg "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\PasswordLess\Device" "DevicePasswordLessBuildVersion" REG_DWORD 0
call :opt_fin "Cuenta sin contrasena: al prender la PC tocas Iniciar sesion y entras"
goto cta_fin
:cta_cancel
call :log "INFO" "el usuario cancelo la confirmacion de la cuenta"
echo %C_WARN%  Cancelado: tu cuenta sigue como estaba. Corre el script de nuevo cuando quieras.%C_RST%
:cta_fin
call :resumen
set "Q=Desea abrir el log ahora?"
call :askS
if not errorlevel 2 start "" notepad "%LOG%"


if defined REINICIO goto cta_pide_reinicio
echo.
echo %C_OK%No hace falta reiniciar.%C_RST%
if not defined XUCA_AUTO pause
exit /b
:cta_pide_reinicio
echo.
echo %C_WARN%Hace falta reiniciar la PC para terminar de aplicar algunos cambios.%C_RST%
set "Q=Desea reiniciar ahora?"
call :askS
if errorlevel 2 goto cta_sin_reinicio
echo Reiniciando en 10 segundos...
shutdown /r /t 10
goto cta_fin_script
:cta_sin_reinicio
echo Reinicia cuando puedas.
if not defined XUCA_AUTO pause
exit /b
:cta_fin_script
