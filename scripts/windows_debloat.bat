echo.
echo.
echo %C_TIT%=== ALMACENAMIENTO Y MEMORIA ===%C_RST%

echo.
echo   Que hace: apaga la hibernacion y el Inicio rapido, y activa la compresion de memoria.
echo   A favor: libera varios GB del disco y cada apagado es completo, con menos errores raros.
echo   En contra: prender la PC desde apagada tarda unos segundos mas.
set "QID=hib"
set "Q=- Desea desactivar la hibernacion? (Libera espacio, apaga el Inicio rapido y activa la compresion de memoria)"
call :askR
if errorlevel 3 goto hib_r
if errorlevel 2 goto hib_fin
