goto rc_fin
:rc_noex
call :log "OMITIDO" "Recall no existe en esta PC: no se toco nada"
echo %C_WARN%  Recall no existe en esta PC, no se toco nada.%C_RST%
goto rc_fin
:rc_r
call :opt_ini "Recall (restaurar)"
echo   Revisando si Recall existe en esta PC, un momento...
set "ACT=RECALL_ON"
call :aplicar_ps
if errorlevel 5 goto rc_regs_r
if errorlevel 2 goto rc_noex
call :resps
:rc_regs_r
call :regdel "HKLM\SOFTWARE\Policies\Microsoft\Windows\WindowsAI" "DisableAIDataAnalysis"
call :regdel "HKCU\SOFTWARE\Policies\Microsoft\Windows\WindowsAI" "DisableAIDataAnalysis"
call :opt_fin "Recall restaurado"
:rc_fin

echo.
echo   Que hace: silencia los sonidos de Windows y el de inicio; quedan solo los de conectar y desconectar dispositivos.
echo   A favor: no te suenan avisos en medio de una partida o un stream.
echo   En contra: no escuchas las alertas del sistema.
set "QID=sch"
set "Q=- Desea silenciar los sonidos de Windows? (Incluye el sonido de inicio; deja solo conectar y desconectar dispositivos, como un USB)"
call :askR
if errorlevel 3 goto sch_r
if errorlevel 2 goto sch_fin
