::EDGEBAT::REM get access and delete registry keys in HKLM hive
::EDGEBAT::REM keys for TakeOwn+FullControl ONLY should be in reg_HKLM_keys_acs var
::EDGEBAT::REM keys that also should be deleted - in reg_HKLM_keys_del var
::EDGEBAT::REM DO NOT pass keys with values at tail
::EDGEBAT::REM TakeOwn+FullControl operation may fails, but removing attempt will be made anyway
::EDGEBAT:::reg_HKLM_keys_access_and_delete
::EDGEBAT::echo [reg_HKLM_keys_access_and_delete()] %cll_dbg%
::EDGEBAT::if defined reg_HKLM_keys_acs goto _reg_HKLM_keys_access_and_delete.psl
::EDGEBAT::if not defined reg_HKLM_keys_del goto _reg_HKLM_keys_access_and_delete.end
::EDGEBAT:::_reg_HKLM_keys_access_and_delete.psl
::EDGEBAT::echo [reg_HKLM_keys_access_and_delete().psl] %cll_dbg%
::EDGEBAT::echo ;^
::EDGEBAT::if ($env:reg_HKLM_keys_acs) { $key_paths_acs = $env:reg_HKLM_keys_acs.Trim().Split([string[]]"\\", [StringSplitOptions]::RemoveEmptyEntries) }^
::EDGEBAT::if ($env:reg_HKLM_keys_del) { $key_paths_del = $env:reg_HKLM_keys_del.Trim().Split([string[]]"\\", [StringSplitOptions]::RemoveEmptyEntries) }^
::EDGEBAT::$key_paths_acs += $key_paths_del;^
::EDGEBAT::if (!$key_paths_acs) { exit }^
::EDGEBAT::$user_ident = [System.Security.Principal.NTAccount]$env:UserName;^
::EDGEBAT::$access_rule = [System.Security.AccessControl.RegistryAccessRule]::new($user_ident, 0xF003F, 3, 0, 0);^
::EDGEBAT::$hive_HKLM = [Microsoft.Win32.Registry]::LocalMachine;^
::EDGEBAT::$ntdll = Add-Type -Member '[DllImport("ntdll.dll")] public static extern int RtlAdjustPrivilege(uint p, bool e, bool t, ref bool l);' -Name NtDll -PassThru;^
::EDGEBAT::$lp = 0; $tgl_rslt = $ntdll::RtlAdjustPrivilege(9, 1, 0, [ref]$lp);^
::EDGEBAT::;^
::EDGEBAT::if ($tgl_rslt -eq 0) {^
::EDGEBAT::	"accessing"%psl_dbg%;^
::EDGEBAT::	foreach ($key_path in $key_paths_acs) {^
::EDGEBAT::		$key_path%psl_dbg%;^
::EDGEBAT::		$key_obj = $hive_HKLM.OpenSubKey($key_path, 2, 0x80000);^
::EDGEBAT::		if (!$key_obj) { "key not found"%psl_dbg%; continue };^
::EDGEBAT::		^
::EDGEBAT::		($acl = $key_obj.GetAccessControl()).SetOwner($user_ident);^
::EDGEBAT::		$key_obj.SetAccessControl($acl);^
::EDGEBAT::		$acl.AddAccessRule($access_rule);^
::EDGEBAT::		$key_obj.SetAccessControl($acl);^
::EDGEBAT::		$key_obj.Close();^
::EDGEBAT::	}^
::EDGEBAT::	$ntdll::RtlAdjustPrivilege(9, $lp, 0, [ref]$lp);^
::EDGEBAT::} else { "TakeOwnership enabling failed (0x{0:x8}); attempt to remove anyway" -f $tgl_rslt%psl_dbg% }^
::EDGEBAT::;"removing"%psl_dbg%;^
::EDGEBAT::foreach ($key_path in $key_paths_del) { $key_path%psl_dbg%; $hive_HKLM.DeleteSubKeyTree($key_path) }^
::EDGEBAT::;| powershell -noprofile - 
::EDGEBAT::
::EDGEBAT:::_reg_HKLM_keys_access_and_delete.end
::EDGEBAT::echo [reg_HKLM_keys_access_and_delete().end] %cll_dbg%
::EDGEBAT::exit /b 0
::EDGEBAT::
::EDGEBAT::
::EDGEBAT::REM unlock and delete all packages from the list
::EDGEBAT::REM list should be in pkgs_list var
::EDGEBAT::REM System.Data.SQLite.dll should be ready to use
::EDGEBAT:::appx_unlock_and_delete
::EDGEBAT::echo [appx_unlock_and_delete()] %cll_dbg%
::EDGEBAT::if not defined pkgs_list goto _appx_unlock_and_delete.end
::EDGEBAT:::_appx_unlock_and_delete.psl
::EDGEBAT::echo [appx_unlock_and_delete().psl] %cll_dbg%
::EDGEBAT::echo function main() {^
::EDGEBAT::	$pkgs = $env:pkgs_list.Split(' ', [StringSplitOptions]::RemoveEmptyEntries);^
::EDGEBAT::	if ($pkgs.Count -eq 0) { "empty packages list"%psl_dbg%; return }^
::EDGEBAT::	$locked_pkgs, $pkgs = $pkgs.Where({$_[0] -eq '1'}, 'Split');^
::EDGEBAT::	$locked_pkgs = $locked_pkgs.ForEach({$_.Substring(1)});^
::EDGEBAT::	$pkgs = $pkgs.ForEach({$_.Substring(1)});^
::EDGEBAT::	^
::EDGEBAT::	if ($env:reg_SFT_paths_scn) { $reg_sft_paths_scn = $env:reg_SFT_paths_scn.Trim().Split([string[]]"\\", [StringSplitOptions]::RemoveEmptyEntries) }^
::EDGEBAT::	if ($env:reg_CLS_paths_scn) { $reg_cls_paths_scn = $env:reg_CLS_paths_scn.Trim().Split([string[]]"\\", [StringSplitOptions]::RemoveEmptyEntries) }^
::EDGEBAT::	if ($reg_sft_paths_scn -or $reg_cls_paths_scn) {^
::EDGEBAT::		$usids_exclude = @('S-1-5-18', 'S-1-5-19', 'S-1-5-20');^
::EDGEBAT::		$reg_usrs_hives = (reg query "$env:REG_USERS_PATH" /k /f "*").ForEach({$_.Substring($_.LastIndexOf('\')+1)}).Where({$_.StartsWith('S-1-') -and -not $usids_exclude.Contains($_)});^
::EDGEBAT::		$reg_sft_hives = ($reg_usrs_hives.ForEach({"HKU\$_\SOFTWARE\"})) + @('HKU\.DEFAULT\SOFTWARE\', 'HKLM\SOFTWARE\');^
::EDGEBAT::		$reg_cls_hives = ($reg_usrs_hives.ForEach({"HKU\$_`_Classes\"})) + @('HKU\.DEFAULT\SOFTWARE\Classes\', 'HKLM\SOFTWARE\Classes\');^
::EDGEBAT::	}^
::EDGEBAT::	^
::EDGEBAT::	if ($locked_pkgs.Count -gt 0) {^
::EDGEBAT::		Add-Type -Path $env:file_SQLite;^
::EDGEBAT::		$attempts = 3; $rslt = $false;^
::EDGEBAT::		while ($attempts) { --$attempts; Unlock-Packages $locked_pkgs ([ref]$rslt); if ($rslt) { break }; Start-Sleep 3 }^
::EDGEBAT::		if ($rslt) { $pkgs += $locked_pkgs } else { "package(s) still locked, exclude:`n" + ($locked_pkgs -join "`n")%psl_dbg% }^
::EDGEBAT::	}^
::EDGEBAT::	^
::EDGEBAT::	"removing"%psl_dbg%;^
::EDGEBAT::	foreach ($pkg in $pkgs) {^
::EDGEBAT::		"package: $pkg`nremove"%psl_dbg%;^
::EDGEBAT::		Remove-AppxPackage -Package $pkg -User $env:USER_SID;^
::EDGEBAT::		Remove-AppxPackage -Package $pkg -AllUsers;^
::EDGEBAT::		^
::EDGEBAT::		$pkg_parts = $pkg.Split('_');^
::EDGEBAT::		foreach ($reg_sft_hive in $reg_sft_hives) { reg delete "$reg_sft_hive`Microsoft\UserData\UninstallTimes" /v "$($pkg_parts[0])_$($pkg_parts[4])" /f }^
::EDGEBAT::		RegCleanup-Package($pkg_parts);^
::EDGEBAT::		$edge_chnl_pos = $pkg_parts[0].IndexOf('.MicrosoftEdge.');^
::EDGEBAT::		if ($edge_chnl_pos -ge 0) {^
::EDGEBAT::			"cleanup of base package"%psl_dbg%;^
::EDGEBAT::			$pkg_parts[0] = $pkg_parts[0].Substring(0, $edge_chnl_pos + 14);^
::EDGEBAT::			RegCleanup-Package $pkg_parts;^
::EDGEBAT::		}^
::EDGEBAT::		^
::EDGEBAT::		"deprovision"%psl_dbg%;^
::EDGEBAT::		reg add "$env:REG_APPX_STORE\EndOfLife\$env:USER_SID\$pkg" /f;^
::EDGEBAT::		reg add "$env:REG_APPX_STORE\EndOfLife\S-1-5-18\$pkg" /f;^
::EDGEBAT::		reg add "$env:REG_APPX_STORE\Deprovisioned\$pkg" /f;^
::EDGEBAT::		^
::EDGEBAT::		"package removed"%psl_dbg%;^
::EDGEBAT::	}^
::EDGEBAT::}^
::EDGEBAT::function Unlock-Packages($pkgs, [ref]$rslt) {^
::EDGEBAT::	"[Unlock-Packages()]`nstopping services"%psl_dbg%;^
::EDGEBAT::	$rslt.Value = $false;^
::EDGEBAT::	Stop-Service StateRepository -Force;^
::EDGEBAT::	^
::EDGEBAT::	"acessing db files"%psl_dbg%;^
::EDGEBAT::	takeown /f "$env:LOC_APPREPO_DB";^
::EDGEBAT::	takeown /f "$env:LOC_APPREPO_DB`-shm";^
::EDGEBAT::	takeown /f "$env:LOC_APPREPO_DB`-wal";^
::EDGEBAT::	icacls "$env:LOC_APPREPO_DB*" /grant "$env:UserName`:F" /c;^
::EDGEBAT::	^
::EDGEBAT::	"unlocking"%psl_dbg%;^
::EDGEBAT::	$con = [System.Data.SQLite.SQLiteConnection]::new("Data Source=$env:LOC_APPREPO_DB");^
::EDGEBAT::	$con.Open();^
::EDGEBAT::	$cmd = $con.CreateCommand();^
::EDGEBAT::	$cmd.CommandText = "SELECT name,sql FROM sqlite_master WHERE type='trigger' AND tbl_name='Package' AND name LIKE'%%AFTER%%' AND name LIKE'%%UPDATE%%'";^
::EDGEBAT::	$res = $cmd.ExecuteReader();^
::EDGEBAT::	$trgs = @{};^
::EDGEBAT::	while ($res.Read()) { $trgs[$res.GetString(0)] = $res.GetString(1) } $res.Close();^
::EDGEBAT::	^
::EDGEBAT::	try {^
::EDGEBAT::		foreach ($trg_name in $trgs.Keys) { $cmd.CommandText = "DROP TRIGGER $trg_name"; $cmd.ExecuteNonQuery() }^
::EDGEBAT::		foreach ($pkg in $pkgs) {^
::EDGEBAT::			"package: $pkg"%psl_dbg%;^
::EDGEBAT::			$cmd.CommandText = "UPDATE Package SET IsInbox=0 WHERE PackageFullName='$pkg'"; $cmd.ExecuteNonQuery();^
::EDGEBAT::			reg delete "$env:REG_APPX_STORE\InboxApplications\$pkg" /f;^
::EDGEBAT::		}^
::EDGEBAT::		foreach ($trg_query in $trgs.Values) { $cmd.CommandText = $trg_query; $cmd.ExecuteNonQuery() }^
::EDGEBAT::		"unlocked"%psl_dbg%;^
::EDGEBAT::		$rslt.Value = $true^
::EDGEBAT::	}^
::EDGEBAT::	catch { $_%psl_dbg%; "unlocking failed"%psl_dbg% }^
::EDGEBAT::	^
::EDGEBAT::	$con.Close();^
::EDGEBAT::	"[Unlock-Packages().end]"%psl_dbg%^
::EDGEBAT::}^
::EDGEBAT::function RegCleanup-Package($pkg_fname_parts) {^
::EDGEBAT::	"[RegCleanup-Package()]`nregistry scan"%psl_dbg%;^
::EDGEBAT::	$pkg_name = $pkg_fname_parts[0] + '_';^
::EDGEBAT::	$pkg_pid = '_' + $pkg_fname_parts[4];^
::EDGEBAT::	$reg_pkg_keys = @();^
::EDGEBAT::	foreach ($reg_sft_hive in $reg_sft_hives) {^
::EDGEBAT::		foreach ($reg_sft_path in $reg_sft_paths_scn) {^
::EDGEBAT::			$reg_pkg_keys += (reg query "$reg_sft_hive$reg_sft_path" /s /f $pkg_name /k).Where({$_.StartsWith('HKEY_') -and $_.Contains($pkg_pid)});^
::EDGEBAT::		}^
::EDGEBAT::	}^
::EDGEBAT::	foreach ($reg_cls_hive in $reg_cls_hives) {^
::EDGEBAT::		foreach ($reg_cls_path in $reg_cls_paths_scn) {^
::EDGEBAT::			$reg_pkg_keys += (reg query "$reg_cls_hive$reg_cls_path" /s /f $pkg_name /k).Where({$_.StartsWith('HKEY_') -and $_.Contains($pkg_pid)});^
::EDGEBAT::		}^
::EDGEBAT::	}^
::EDGEBAT::	$reg_pkg_keys += (reg query "$env:REG_APPX_STORE" /s /f $pkg_name /k).Where({$_.StartsWith('HKEY_') -and $_.Contains($pkg_pid)});^
::EDGEBAT::	$reg_pkg_keys += (reg query "$env:REG32_APPX_STORE" /s /f $pkg_name /k).Where({$_.StartsWith('HKEY_') -and $_.Contains($pkg_pid)});^
::EDGEBAT::	^
::EDGEBAT::	"registry cleanup"%psl_dbg%;^
::EDGEBAT::	foreach ($reg_pkg_key in $reg_pkg_keys) { $reg_pkg_key%psl_dbg%; reg delete $reg_pkg_key /f }^
::EDGEBAT::	"[RegCleanup-Package().end]"%psl_dbg%;^
::EDGEBAT::}^
::EDGEBAT::main;^
::EDGEBAT::;| powershell -noprofile - 
::EDGEBAT::
::EDGEBAT:::_appx_unlock_and_delete.end
::EDGEBAT::echo [appx_unlock_and_delete().end] %cll_dbg%
::EDGEBAT::exit /b 0

