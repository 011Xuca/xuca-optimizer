::EDGEBAT::
::EDGEBAT::REM EdgeCore holds the actual Edge/WebView2 engine binaries: each installed
::EDGEBAT::REM version (Edge browser and/or WebView2 Runtime) gets its own subfolder there.
::EDGEBAT::REM This script does not touch WebView2, but a blanket "rd /s /q" on EdgeCore
::EDGEBAT::REM deletes WebView2's active engine files too, breaking it (and anything
::EDGEBAT::REM depending on it, e.g. Windows Search, many Electron/embedded-browser apps).
::EDGEBAT::REM Only delete subfolders that do not match the currently registered WebView2
::EDGEBAT::REM Runtime version.
::EDGEBAT:::edgecore_cleanup
::EDGEBAT::echo [edgecore_cleanup()] %cll_dbg%
::EDGEBAT::if not exist "%x86ProgramsFolder%\Microsoft\EdgeCore" goto _edgecore_cleanup.end
::EDGEBAT::
::EDGEBAT::set "webview2_ver="
::EDGEBAT::for /f "tokens=2,*" %%a in ('reg query "HKLM\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" /v pv 2^>NUL ^| findstr /i "REG_SZ"') do set "webview2_ver=%%b"
::EDGEBAT::if not defined webview2_ver (
::EDGEBAT::	for /f "tokens=2,*" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" /v pv 2^>NUL ^| findstr /i "REG_SZ"') do set "webview2_ver=%%b"
::EDGEBAT::)
::EDGEBAT::if not defined webview2_ver (
::EDGEBAT::	for /f "tokens=2,*" %%a in ('reg query "HKLM\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft EdgeWebView" /v DisplayVersion 2^>NUL ^| findstr /i "REG_SZ"') do set "webview2_ver=%%b"
::EDGEBAT::)
::EDGEBAT::if not defined webview2_ver (
::EDGEBAT::	for /f "tokens=2,*" %%a in ('reg query "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Microsoft EdgeWebView" /v DisplayVersion 2^>NUL ^| findstr /i "REG_SZ"') do set "webview2_ver=%%b"
::EDGEBAT::)
::EDGEBAT::echo webview2_ver: "%webview2_ver%" %cll_dbg%
::EDGEBAT::
::EDGEBAT::REM If unknown in-use version, don't delete anything.
::EDGEBAT::if not defined webview2_ver (
::EDGEBAT::	echo webview2_ver not found - skipping EdgeCore cleanup to avoid breaking WebView2 %cll_dbg%
::EDGEBAT::	goto _edgecore_cleanup.end
::EDGEBAT::)
::EDGEBAT::
::EDGEBAT::for /d %%d in ("%x86ProgramsFolder%\Microsoft\EdgeCore\*") do (
::EDGEBAT::	if /i not "%%~nxd" equ "%webview2_ver%" (
::EDGEBAT::		echo removing: "%%~d" %cll_dbg%
::EDGEBAT::		rd /s /q "%%~d" %cll_dbg%
::EDGEBAT::	) else (
::EDGEBAT::		echo keeping ^(in use by WebView2^): "%%~d" %cll_dbg%
::EDGEBAT::	)
::EDGEBAT::)
::EDGEBAT::REM remove the now-empty parent folder; fails silently (as intended) if WebView2's subfolder is still there
::EDGEBAT::rd "%x86ProgramsFolder%\Microsoft\EdgeCore" 2>NUL
::EDGEBAT::
::EDGEBAT:::_edgecore_cleanup.end
::EDGEBAT::echo [edgecore_cleanup().end] %cll_dbg%
::EDGEBAT::exit /b 0
::EDGEBAT::
