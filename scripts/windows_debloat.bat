::EDGEBAT::del /f /q "%file_setup%" %bat_log%
::EDGEBAT::del /f /q "%file_SQLite%" %bat_log%
::EDGEBAT::echo [main_script.done] %bat_dbg%
::EDGEBAT::exit /b 0
